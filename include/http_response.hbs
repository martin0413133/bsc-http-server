#ifndef CC_HTTP_RESPONSE_HBS
#define CC_HTTP_RESPONSE_HBS
#include <stddef.h>
#include "bishengc_safety.hbs"

// 仅所有权（无 _Owned struct）：普通 struct 持有 owned body，调用方用 response_free 释放。
// status_text/content_type 用定长数组而非 const char*：安全区禁止把借用结构里的指针字段
// 拷出为独立指针，但数组字段经借用穿透访问/传参是允许的（同 Request 的 method/path）。
struct Response {
    int status;
    char status_text[32];      // 如 "OK"
    char content_type[64];     // 如 "text/html"
    char *_Owned _ArrayElem body;
    size_t body_len;
};

// 消费一个已拥有的体缓冲
_Safe struct Response response_with_owned(int status, const char* _Nonnull status_text,
                                          const char* _Nonnull content_type,
                                          char *_Owned _ArrayElem body, size_t body_len);
// 以 C 字符串构建体（内部复制到 owned 缓冲）
_Safe struct Response response_with_cstr(int status, const char* _Nonnull status_text,
                                         const char* _Nonnull content_type, const char* _Nonnull body);
_Safe struct Response response_not_found(void);
_Safe struct Response response_bad_request(void);
_Safe struct Response response_server_error(void);
// 序列化完整报文到 owned 缓冲；长度经 out_len 返回。调用方负责 safe_free_array。
_Safe char *_Owned _ArrayElem response_serialize(const struct Response* _Borrow r, size_t* _Borrow out_len);
// 释放 Response 的 owned 资源（按值移入）。
_Safe void response_free(struct Response r);
#endif

#ifndef CC_CONFIG_HBS
#define CC_CONFIG_HBS
#include "cstring.hbs"

typedef struct Config {
    int port;
    int threads;
    cstring document_root;
    int ssl_port;
    cstring ssl_cert;
    cstring ssl_key;
} Config;

_Safe void Config_free(Config c) {
    cstring_free(c.document_root);
    cstring_free(c.ssl_cert);
    cstring_free(c.ssl_key);
}

_Safe Config Config_default(void);
_Safe Config Config_parse(const cstring* _Borrow text);
#endif

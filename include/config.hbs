#ifndef CC_CONFIG_HBS
#define CC_CONFIG_HBS
#include <stddef.h>

struct Config {
    int port;
    int threads;
    char document_root[256];
};

_Safe struct Config config_default(void);
// 从缓冲解析。形参用 _Borrow _ArrayElem：既能下标遍历，又能直接收字面量与
// owned 缓冲的 &_Const x[0]（免去把 owned 拷到栈裸缓冲）。
_Safe struct Config config_parse(const char *_Borrow _ArrayElem text);
#endif

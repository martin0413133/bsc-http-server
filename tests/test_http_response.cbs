#include <stdio.h>
#include <string.h>
#include "../src/str_util.cbs"
#include "../src/http_response.cbs"

static int fails = 0;
#define CHECK(c,m) do{ if(!(c)){_Unsafe{printf("FAIL: %s\n",m);}fails++;} }while(0)

static _Bool contains(const cstring* _Borrow s, const char* _Nonnull needle) {
    char buf[4096]; cstring_to_cbuf(s, buf, 4096);
    _Unsafe { return strstr(buf, needle) != NULL; }
}

int main(void) {
    Response ok = Response_ok_text("hello", "text/plain");
    cstring wire = Response_to_string(&_Const ok);
    CHECK(contains(&_Const wire, "HTTP/1.1 200 OK\r\n"), "status line");
    CHECK(contains(&_Const wire, "Content-Type: text/plain\r\n"), "ctype");
    CHECK(contains(&_Const wire, "Content-Length: 5\r\n"), "clen");
    CHECK(contains(&_Const wire, "\r\n\r\nhello"), "body sep");

    Response nf = Response_not_found();
    cstring w2 = Response_to_string(&_Const nf);
    CHECK(contains(&_Const w2, "HTTP/1.1 404 Not Found\r\n"), "404 line");

    Response mna = Response_method_not_allowed();
    cstring w3 = Response_to_string(&_Const mna);
    CHECK(contains(&_Const w3, "HTTP/1.1 405 Method Not Allowed\r\n"), "405 line");

    cstring_free(wire);
    cstring_free(w2);
    cstring_free(w3);
    Response_free(ok);
    Response_free(nf);
    Response_free(mna);
    if (fails) { _Unsafe{printf("%d failures\n", fails);} return 1; }
    _Unsafe{printf("test_http_response OK\n");}
    return 0;
}

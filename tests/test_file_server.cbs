#include <stdio.h>
#include <string.h>
#include "../src/str_util.cbs"
#include "../src/http_request.cbs"
#include "../src/http_response.cbs"
#include "../src/config.cbs"
#include "../src/router.cbs"
#include "../src/mime.cbs"
#include "../src/platform/fs.cbs"
#include "../src/file_server.cbs"

static int fails = 0;
#define CHECK(c,m) do{ if(!(c)){_Unsafe{printf("FAIL: %s\n",m);}fails++;} }while(0)

int main(void) {
    cstring cfgtext = cstring_new();
    str_append_cstr(&_Mut cfgtext, "document_root = www\n");
    Config cfg = Config_parse(&_Const cfgtext);

    Request req = Request_parse("GET / HTTP/1.1\r\n\r\n");
    Response resp = serve_static(&_Const cfg, &_Const req);
    CHECK(resp.status == 200, "index 200");
    char b[8192]; cstring_to_cbuf(&_Const resp.body, b, 8192);
    _Unsafe { CHECK(strstr(b, "cc_httpd") != NULL, "index body"); }

    Request r2 = Request_parse("GET /nope.html HTTP/1.1\r\n\r\n");
    Response resp2 = serve_static(&_Const cfg, &_Const r2);
    CHECK(resp2.status == 404, "missing 404");

    Request r3 = Request_parse("GET /../Makefile HTTP/1.1\r\n\r\n");
    Response resp3 = serve_static(&_Const cfg, &_Const r3);
    CHECK(resp3.status == 404, "traversal 404");

    cstring_free(cfgtext);
    Config_free(cfg);
    Request_free(req); Request_free(r2); Request_free(r3);
    Response_free(resp); Response_free(resp2); Response_free(resp3);
    if (fails) { _Unsafe{printf("%d failures\n", fails);} return 1; }
    _Unsafe{printf("test_file_server OK\n");}
    return 0;
}

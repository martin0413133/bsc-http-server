#include <stdio.h>
#include <string.h>
#include "../src/str_util.cbs"
#include "../src/platform/fs.cbs"

static int fails = 0;
#define CHECK(c,m) do{ if(!(c)){_Unsafe{printf("FAIL: %s\n",m);}fails++;} }while(0)

int main(void) {
    cstring s = cstring_new();
    _Bool ok = fs_read_file("config.ini", &_Mut s);
    CHECK(ok, "read config.ini");
    CHECK(cstring_len(&_Const s) > 0, "non-empty");

    char buf[512];
    cstring_to_cbuf(&_Const s, buf, 512);
    _Unsafe { CHECK(strstr(buf, "port") != NULL, "has port key"); }

    cstring s2 = cstring_new();
    _Bool bad = fs_read_file("definitely-not-here-xyz", &_Mut s2);
    CHECK(!bad, "missing file returns false");

    cstring_free(s);
    cstring_free(s2);
    if (fails) { _Unsafe{printf("%d failures\n", fails);} return 1; }
    _Unsafe{printf("test_fs OK\n");}
    return 0;
}

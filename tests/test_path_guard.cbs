#include <stdio.h>
#include "../src/str_util.cbs"
#include "../src/http_request.cbs"
#include "../src/http_response.cbs"
#include "../src/router.cbs"

static int fails = 0;
#define CHECK(c,m) do{ if(!(c)){_Unsafe{printf("FAIL: %s\n",m);}fails++;} }while(0)

static _Safe cstring mkstr(const char* _Nonnull c) {
    cstring s = cstring_new();
    str_append_cstr(&_Mut s, c);
    return s;
}

int main(void) {
    cstring p1 = mkstr("/index.html");    CHECK(path_is_safe(&_Const p1), "normal ok");
    cstring p2 = mkstr("/css/style.css"); CHECK(path_is_safe(&_Const p2), "subdir ok");
    cstring p3 = mkstr("/../etc/passwd"); CHECK(!path_is_safe(&_Const p3), "dotdot rejected");
    cstring p4 = mkstr("/a/../../b");     CHECK(!path_is_safe(&_Const p4), "embedded dotdot rejected");
    cstring_free(p1); cstring_free(p2); cstring_free(p3); cstring_free(p4);
    if (fails) { _Unsafe{printf("%d failures\n", fails);} return 1; }
    _Unsafe{printf("test_path_guard OK\n");}
    return 0;
}

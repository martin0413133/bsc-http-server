// Minimal reproducer for the BiSheng C codegen UAF — BSC-IMPROVEMENTS.md issue #1.
//
// `return f(&_Const local)`, where `local` is an _Owned value (here a String-bearing
// struct) and `f` borrows it, runs `local`'s destructor BEFORE `f` finishes reading the
// borrow. The borrow checker accepts it; the program often "passes" by luck (freed page
// not yet reused); valgrind deterministically flags an Invalid read freed by String_D.
//
// Build & run via tests/uaf_repro.sh, or manually:
//   CC=/home/zly/bsc/llvm-project/build/bin/clang
//   INC=-I/home/zly/bsc/llvm-project/install/include/libcbs
//   LIB="-L/home/zly/bsc/llvm-project/install/lib -lstdcbs -lpthread"
//   $CC -g $INC -DREPRO_BAD tests/uaf_repro.cbs -o /tmp/uaf_bad  $LIB   # buggy tail-return
//   $CC -g $INC             tests/uaf_repro.cbs -o /tmp/uaf_good $LIB   # bind-then-return
//   valgrind -q --error-exitcode=1 /tmp/uaf_bad     # -> Invalid read ... freed by String_D
//   valgrind -q --error-exitcode=1 /tmp/uaf_good    # -> clean
#include <stdio.h>
#include "string.hbs"

_Owned struct Holder {
_Public:
    String name;
};

// Reads every byte of the Holder's String heap buffer through the borrow.
// If `h` was already destructed, these reads hit freed memory.
_Safe size_t count_a(const Holder* _Borrow h) {
    size_t n = h->name.length();
    size_t cnt = 0;
    for (size_t i = 0; i < n; i++) {
        if (h->name.at(i) == 'a') { cnt++; }
    }
    return cnt;
}

_Safe size_t run(void) {
    Holder h = { .name = String::new() };
    for (int i = 0; i < 64; i++) { h.name.push('a'); }  // force a heap allocation
#ifdef REPRO_BAD
    return count_a(&_Const h);          // BUG: h destructed before count_a reads it
#else
    size_t r = count_a(&_Const h);      // FIX: h stays alive through the call
    return r;
#endif
}

int main(void) {
    size_t r = run();
    _Unsafe { printf("count=%zu\n", r); }
    return 0;
}

// Minimal reproducer for the BiSheng C codegen UAF.
#include <stdio.h>
#include "../include/cstring.hbs"

typedef struct Holder { cstring name; } Holder;

_Safe size_t count_a(const Holder* _Borrow h) {
    size_t n = cstring_len(&_Const h->name);
    size_t cnt = 0;
    for (size_t i = 0; i < n; i++) {
        if (cstring_at(&_Const h->name, i) == 'a') { cnt++; }
    }
    return cnt;
}

_Safe size_t run(void) {
    Holder h = { .name = cstring_new() };
    for (int i = 0; i < 64; i++) { cstring_push(&_Mut h.name, 'a'); }
    size_t r = count_a(&_Const h);
    cstring_free(h.name);
    return r;
}

int main(void) {
    size_t r = run();
    _Unsafe { printf("count=%zu\n", r); }
    return 0;
}

#include "../include/str_util.hbs"

_Safe void str_append_cstr(cstring* _Borrow s, const char* _Nonnull cstr) {
    cstring_append_cstr(s, cstr);
}

_Safe void str_append(cstring* _Borrow dst, const cstring* _Borrow src) {
    cstring_append(dst, src);
}

_Safe size_t str_to_cbuf(const cstring* _Borrow s, char* _Nonnull out, size_t cap) {
    return cstring_to_cbuf(s, out, cap);
}

_Safe _Bool str_eq_cstr(const cstring* _Borrow s, const char* _Nonnull cstr) {
    return cstring_eq_cstr(s, cstr);
}

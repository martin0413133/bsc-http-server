#include "../include/config.hbs"
#include "../include/str_util.hbs"

_Safe Config Config::default_config(void) {
    String dr = String::new();
    str_append_cstr(&_Mut dr, "www");
    Config c = { .port = 8080, .threads = 4, .document_root = dr };
    return c;
}

// parse decimal int from a String (digits only)
_Safe int parse_int(const String* _Borrow s) {
    int v = 0;
    size_t n = s->length();
    for (size_t i = 0; i < n; i++) {
        char ch = s->at(i);
        if (ch >= '0' && ch <= '9') { v = v * 10 + (ch - '0'); }
    }
    return v;
}

// Char at index, or '\0' past the end. Lets the NUL-sentinel scanner below run
// unchanged on a (non-NUL-terminated) String borrow.
static _Safe char at_or_nul(const String* _Borrow s, size_t i) {
    return i < s->length() ? s->at(i) : '\0';
}

_Safe Config Config::parse(const String* _Borrow text) {
    int port = 8080;
    int threads = 4;
    String dr = String::new();
    str_append_cstr(&_Mut dr, "www");

    size_t i = 0;
    while (at_or_nul(text, i) != '\0') {
        while (at_or_nul(text, i) == ' ' || at_or_nul(text, i) == '\t') { i++; }
        if (at_or_nul(text, i) == '#' || at_or_nul(text, i) == '\n' || at_or_nul(text, i) == '\r') {
            while (at_or_nul(text, i) != '\0' && at_or_nul(text, i) != '\n') { i++; }
            if (at_or_nul(text, i) == '\n') { i++; }
            continue;
        }
        if (at_or_nul(text, i) == '\0') { break; }
        String key = String::new();
        String val = String::new();
        while (at_or_nul(text, i) != '\0' && at_or_nul(text, i) != '=' && at_or_nul(text, i) != '\n' && at_or_nul(text, i) != ' ' && at_or_nul(text, i) != '\t') { key.push(at_or_nul(text, i)); i++; }
        while (at_or_nul(text, i) == ' ' || at_or_nul(text, i) == '\t') { i++; }
        if (at_or_nul(text, i) == '=') { i++; }
        while (at_or_nul(text, i) == ' ' || at_or_nul(text, i) == '\t') { i++; }
        while (at_or_nul(text, i) != '\0' && at_or_nul(text, i) != '\n' && at_or_nul(text, i) != '\r' && at_or_nul(text, i) != ' ') { val.push(at_or_nul(text, i)); i++; }
        while (at_or_nul(text, i) != '\0' && at_or_nul(text, i) != '\n') { i++; }
        if (at_or_nul(text, i) == '\n') { i++; }

        if (str_eq_cstr(&_Const key, "port")) { port = parse_int(&_Const val); }
        else if (str_eq_cstr(&_Const key, "threads")) { threads = parse_int(&_Const val); }
        else if (str_eq_cstr(&_Const key, "document_root")) { safe_swap(&_Mut dr, &_Mut val); }
    }

    // Reject out-of-range values (parse_int has no overflow guard); fall back to defaults.
    if (port < 1 || port > 65535) { port = 8080; }
    if (threads < 1) { threads = 1; }

    Config c = { .port = port, .threads = threads, .document_root = dr };
    return c;
}

#ifndef CC_NET_HBS
#define CC_NET_HBS
#include <stddef.h>
#include "string.hbs"

// Adapter: _Safe interface over POSIX sockets; _Unsafe only inside.
_Safe int   net_listen(int port, int backlog);   // listen fd, or -1 on error
_Safe int   net_accept(int listen_fd);            // client fd, or -1
_Safe _Bool net_recv_string(int fd, String* _Borrow out);   // read one request into out
_Safe _Bool net_send_string(int fd, const String* _Borrow data); // length-based send
_Safe void  net_close(int fd);
#endif

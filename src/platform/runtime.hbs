#ifndef CC_RUNTIME_HBS
#define CC_RUNTIME_HBS
#include "../../include/config.hbs"
#include "../../include/router.hbs"

// Read-only shared context handed to worker threads (raw pointers; the pointees
// live for the whole server run via __move_to_raw). ssl_ctx is NULL when SSL is disabled.
struct ServerCtx {
    const Config* _Nonnull config;
    const Router* _Nonnull router;
    void* _Nullable ssl_ctx;   // SSLCtx*
};

// Take ownership of cfg/router, bind, spawn the pool, run the accept loop forever.
// Returns -1 on bind/pool failure.
_Safe int runtime_serve(Config *_Owned cfg, Router *_Owned router);
#endif

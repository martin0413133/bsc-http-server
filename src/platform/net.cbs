#include "net.hbs"
#include "bishengc_safety.hbs"
#include <unistd.h>
#include <string.h>
#include <sys/socket.h>
#include <sys/time.h>
#include <netinet/in.h>
#include <arpa/inet.h>
#include <openssl/ssl.h>
#include <openssl/err.h>

#define NET_RECV_BUF 8192
#define NET_SEND_CHUNK 4096
#define NET_TIMEOUT_SEC 10   // per-connection recv/send timeout — bounds slow/idle clients

_Safe int net_listen(int port, int backlog) {
    _Unsafe {
        int fd = socket(AF_INET, SOCK_STREAM, 0);
        if (fd < 0) { return -1; }
        int opt = 1;
        setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt));
        struct sockaddr_in addr;
        memset(&addr, 0, sizeof(addr));
        addr.sin_family = AF_INET;
        addr.sin_addr.s_addr = htonl(INADDR_ANY);
        addr.sin_port = htons((unsigned short)port);
        if (bind(fd, (struct sockaddr*)&addr, sizeof(addr)) < 0) { close(fd); return -1; }
        if (listen(fd, backlog) < 0) { close(fd); return -1; }
        return fd;
    }
}

_Safe int net_accept(int listen_fd) {
    _Unsafe {
        int fd = accept(listen_fd, NULL, NULL);
        if (fd >= 0) {
            struct timeval tv;
            tv.tv_sec = NET_TIMEOUT_SEC;
            tv.tv_usec = 0;
            setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
            setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof(tv));
        }
        return fd;
    }
}

_Safe _Bool net_recv_string(int fd, String* _Borrow out) {
    char buf[NET_RECV_BUF] = {0};
    ssize_t n;
    _Unsafe { n = recv(fd, buf, NET_RECV_BUF - 1, 0); }
    if (n <= 0) { return 0; }
    size_t got = (size_t)n;
    for (size_t i = 0; i < got; i++) { out->push(buf[i]); }
    return 1;
}

_Safe _Bool net_send_string(int fd, const String* _Borrow data) {
    size_t len = data->length();
    size_t off = 0;
    while (off < len) {
        char chunk[NET_SEND_CHUNK] = {0};
        size_t m = 0;
        while (off < len && m < NET_SEND_CHUNK) { chunk[m] = data->at(off); m++; off++; }
        _Unsafe {
            size_t sent = 0;
            while (sent < m) {
                ssize_t s = send(fd, chunk + sent, m - sent, 0);
                if (s <= 0) { return 0; }
                sent += (size_t)s;
            }
        }
    }
    return 1;
}

_Safe void net_close(int fd) { _Unsafe { close(fd); } }

// --- SSL support ---

_Safe SSLCtx *_Owned _Nullable net_ssl_ctx_new(const char* _Nonnull cert_file,
                                                const char* _Nonnull key_file) {
    void* raw;  // SSL_CTX*, filled in _Unsafe
    _Unsafe { raw = (void*)SSL_CTX_new(TLS_server_method()); }
    if (!raw) { return nullptr; }

    _Unsafe {
        SSL_CTX_set_mode((SSL_CTX*)raw, SSL_MODE_AUTO_RETRY);
        if (SSL_CTX_use_certificate_file((SSL_CTX*)raw, cert_file, SSL_FILETYPE_PEM) <= 0
            || SSL_CTX_use_PrivateKey_file((SSL_CTX*)raw, key_file, SSL_FILETYPE_PEM) <= 0
            || SSL_CTX_check_private_key((SSL_CTX*)raw) <= 0) {
            SSL_CTX_free((SSL_CTX*)raw);
            return nullptr;
        }
    }

    SSLCtx val = { .raw_ctx = (void* _Nonnull)raw };
    SSLCtx *_Owned p = safe_malloc(val);
    return p;
}

_Safe SSLConn *_Owned _Nullable net_ssl_accept(const SSLCtx* _Borrow ctx, int fd) {
    void* raw_ssl;  // SSL*, filled in _Unsafe
    _Unsafe { raw_ssl = (void*)SSL_new((SSL_CTX*)ctx->raw_ctx); }
    if (!raw_ssl) { return nullptr; }

    _Unsafe {
        SSL_set_fd((SSL*)raw_ssl, fd);
        if (SSL_accept((SSL*)raw_ssl) <= 0) {
            SSL_free((SSL*)raw_ssl);
            return nullptr;
        }
    }

    SSLConn val = { .raw_ssl = (void* _Nonnull)raw_ssl, .fd = fd };
    SSLConn *_Owned p = safe_malloc(val);
    return p;
}

_Safe _Bool net_ssl_recv_string(const SSLConn* _Borrow ssl, String* _Borrow out) {
    char buf[NET_RECV_BUF] = {0};
    int n;
    _Unsafe { n = SSL_read((SSL*)ssl->raw_ssl, buf, NET_RECV_BUF - 1); }
    if (n <= 0) { return 0; }
    size_t got = (size_t)n;
    for (size_t i = 0; i < got; i++) { out->push(buf[i]); }
    return 1;
}

_Safe _Bool net_ssl_send_string(const SSLConn* _Borrow ssl, const String* _Borrow data) {
    size_t len = data->length();
    size_t off = 0;
    while (off < len) {
        char chunk[NET_SEND_CHUNK] = {0};
        size_t m = 0;
        while (off < len && m < NET_SEND_CHUNK) { chunk[m] = data->at(off); m++; off++; }
        _Unsafe {
            int sent = SSL_write((SSL*)ssl->raw_ssl, chunk, (int)m);
            if (sent <= 0) { return 0; }
        }
    }
    return 1;
}

_Safe void net_ssl_conn_free(SSLConn *_Owned _Nullable ssl) {
    if (!ssl) { return; }
    _Unsafe {
        SSL_shutdown((SSL*)ssl->raw_ssl);
        SSL_free((SSL*)ssl->raw_ssl);
        close(ssl->fd);
    }
    safe_free((void *_Owned)ssl);
}

_Safe void net_ssl_ctx_free(SSLCtx *_Owned _Nullable ctx) {
    if (!ctx) { return; }
    _Unsafe { SSL_CTX_free((SSL_CTX*)ctx->raw_ctx); }
    safe_free((void *_Owned)ctx);
}

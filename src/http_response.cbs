#include "../include/http_response.hbs"
#include "../include/str_util.hbs"

_Safe Response Response_make(int status, const char* _Nonnull status_text) {
    Response r = {
        .status = status,
        .status_text = cstring_new(),
        .content_type = cstring_new(),
        .body = cstring_new()
    };
    str_append_cstr(&_Mut r.status_text, status_text);
    return r;
}

_Safe Response Response_ok_body(cstring body, const char* _Nonnull content_type) {
    cstring st = cstring_new();
    str_append_cstr(&_Mut st, "OK");
    cstring ct = cstring_new();
    str_append_cstr(&_Mut ct, content_type);
    Response r = { .status = 200, .status_text = st, .content_type = ct, .body = body };
    return r;
}

_Safe Response Response_ok_text(const char* _Nonnull body, const char* _Nonnull content_type) {
    cstring b = cstring_new();
    str_append_cstr(&_Mut b, body);
    return Response_ok_body(b, content_type);
}

_Safe Response Response_not_found(void) {
    Response r = Response_make(404, "Not Found");
    str_append_cstr(&_Mut r.content_type, "text/html");
    str_append_cstr(&_Mut r.body, "<h1>404 Not Found</h1>");
    return r;
}

_Safe Response Response_bad_request(void) {
    Response r = Response_make(400, "Bad Request");
    str_append_cstr(&_Mut r.content_type, "text/html");
    str_append_cstr(&_Mut r.body, "<h1>400 Bad Request</h1>");
    return r;
}

_Safe Response Response_method_not_allowed(void) {
    Response r = Response_make(405, "Method Not Allowed");
    str_append_cstr(&_Mut r.content_type, "text/html");
    str_append_cstr(&_Mut r.body, "<h1>405 Method Not Allowed</h1>");
    return r;
}

_Safe void append_size(cstring* _Borrow out, size_t n) {
    if (n == 0) { cstring_push(out, '0'); return; }
    char tmp[24] = {0};
    size_t k = 0;
    while (n > 0) { tmp[k] = (char)('0' + (n % 10)); n /= 10; k++; }
    while (k > 0) { k--; cstring_push(out, tmp[k]); }
}

_Safe cstring Response_to_string(const Response* _Borrow this) {
    cstring out = cstring_new();
    str_append_cstr(&_Mut out, "HTTP/1.1 ");
    append_size(&_Mut out, (size_t)this->status);
    cstring_push(&_Mut out, ' ');
    str_append(&_Mut out, &_Const this->status_text);
    str_append_cstr(&_Mut out, "\r\nContent-Type: ");
    str_append(&_Mut out, &_Const this->content_type);
    str_append_cstr(&_Mut out, "\r\nContent-Length: ");
    append_size(&_Mut out, cstring_len(&_Const this->body));
    str_append_cstr(&_Mut out, "\r\nConnection: close\r\n\r\n");
    str_append(&_Mut out, &_Const this->body);
    return out;
}

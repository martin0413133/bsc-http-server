#include "../include/handler.hbs"
#include "../include/http_request.hbs"
#include "../include/file_server.hbs"
#include "../include/str_util.hbs"   // str_eq_cstr

_Safe Response handle_request(const Config* _Borrow cfg, const Router* _Borrow router,
                              const char* _Nonnull raw) {
    Request req = Request::parse(raw);
    if (!req.ok) {
        Response resp = Response::bad_request();
        return resp;
    }
    Handler h = router->match(&_Const req);
    // NOTE: bind the result to a local before returning. `return call(&_Const req)`
    // destroys the local `req` before the callee finishes reading the borrow
    // (destructor-ordering codegen bug) — a named temporary keeps req alive.
    if (h != nullptr) {
        Response resp = h(&_Const req);
        return resp;
    }
    // Static serving is read-only: only GET is supported. Other methods get 405.
    if (!str_eq_cstr(&_Const req.method, "GET")) {
        Response resp = Response::method_not_allowed();
        return resp;
    }
    Response resp = serve_static(cfg, &_Const req);
    return resp;
}

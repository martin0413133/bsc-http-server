#include "../include/mime.hbs"
#include <stddef.h>

// Compare the suffix of `s` starting at index `start` against literal `lit`.
// Pure safe-zone: only _Nonnull raw-buffer subscript reads, no libc.
_Safe _Bool suffix_eq(const char* _Nonnull s, size_t start, const char* _Nonnull lit) {
    size_t j = 0;
    while (lit[j] != '\0') {
        if (s[start + j] != lit[j]) { return 0; }
        j++;
    }
    return s[start + j] == '\0';
}

_Safe const char* mime_for_path(const char* _Nonnull path) {
    size_t last_dot = 0;
    _Bool has_dot = 0;
    for (size_t i = 0; path[i] != '\0'; i++) {
        if (path[i] == '.') { last_dot = i; has_dot = 1; }
    }
    if (!has_dot) { return "application/octet-stream"; }
    size_t e = last_dot + 1;
    if (suffix_eq(path, e, "html") || suffix_eq(path, e, "htm")) { return "text/html"; }
    if (suffix_eq(path, e, "css"))  { return "text/css"; }
    if (suffix_eq(path, e, "js"))   { return "application/javascript"; }
    if (suffix_eq(path, e, "json")) { return "application/json"; }
    if (suffix_eq(path, e, "png"))  { return "image/png"; }
    if (suffix_eq(path, e, "jpg") || suffix_eq(path, e, "jpeg")) { return "image/jpeg"; }
    if (suffix_eq(path, e, "gif"))  { return "image/gif"; }
    if (suffix_eq(path, e, "svg"))  { return "image/svg+xml"; }
    if (suffix_eq(path, e, "txt"))  { return "text/plain"; }
    return "application/octet-stream";
}

#include "../include/router.hbs"
#include "../include/str_util.hbs"

_Safe Router Router_new(void) {
    Router r = { .routes_len = 0 };
    router_routes_init(&_Mut r, 4);
    return r;
}

_Safe void Router_add(Router* _Borrow this, const char* _Nonnull method, const char* _Nonnull path, Handler h) {
    cstring m = cstring_new();
    str_append_cstr(&_Mut m, method);
    cstring p = cstring_new();
    str_append_cstr(&_Mut p, path);
    Route rt = { .method = m, .path = p, .handler = h };
    router_routes_push(this, rt);
}

_Safe Handler _Nullable Router_match(const Router* _Borrow this, const Request* _Borrow req) {
    size_t n = this->routes_len;
    for (size_t k = 0; k < n; k++) {
        const Route* _Borrow rt = router_route_get(this, k);
        if (cstring_eq(&_Const rt->method, &_Const req->method) && cstring_eq(&_Const rt->path, &_Const req->path)) {
            return rt->handler;
        }
    }
    return nullptr;
}

_Safe _Bool path_is_safe(const cstring* _Borrow path) {
    size_t n = cstring_len(path);
    for (size_t i = 0; i + 1 < n; i++) {
        if (cstring_at(path, i) == '.' && cstring_at(path, i + 1) == '.') { return 0; }
    }
    return 1;
}

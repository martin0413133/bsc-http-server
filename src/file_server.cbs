#include "../include/file_server.hbs"
#include "../include/str_util.hbs"
#include "../include/router.hbs"
#include "../include/mime.hbs"
#include "platform/fs.hbs"

_Safe Response serve_static(const Config* _Borrow config, const Request* _Borrow req) {
    cstring rel = cstring_new();
    if (cstring_eq_cstr(&_Const req->path, "/")) { str_append_cstr(&_Mut rel, "/index.html"); }
    else { str_append(&_Mut rel, &_Const req->path); }

    if (!path_is_safe(&_Const rel)) { cstring_free(rel); return Response_not_found(); }

    cstring full = cstring_new();
    str_append(&_Mut full, &_Const config->document_root);
    str_append(&_Mut full, &_Const rel);

    char pathbuf[2048] = {0};
    cstring_to_cbuf(&_Const full, pathbuf, 2048);

    cstring body = cstring_new();
    _Bool ok = fs_read_file(pathbuf, &_Mut body);
    cstring_free(rel);
    cstring_free(full);
    if (!ok) { cstring_free(body); return Response_not_found(); }
    return Response_ok_body(body, mime_for_path(pathbuf));
}
